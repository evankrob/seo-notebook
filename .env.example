# Copy to .dev.vars for wrangler (not .env). No provider credentials needed.
CONNECTOR_MODE=mock
# Local mode (no Cloudflare Access): requests to localhost act as this user.
LOCAL_USER_EMAIL=owner@localhost
# Demo agent token in README and fixtures is a public local fixture only.
# Optional: live Search Console/GA4. One-line JSON key (jq -c . service-account.json). In production use `wrangler secret put`.
# GOOGLE_SERVICE_ACCOUNT='{"type":"service_account",...}'
