{
    // Marketing site only. The notebook itself is the Worker at the repository root.
    "name": "seo-notebook-site",
    "compatibility_date": "2026-10-14",
    "main": "./worker.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        // The Worker only redirects the bare domain; it hands every other request to the assets.
        "run_worker_first": true
    },
    // Cloudflare creates the DNS records and certificates for the zone on deploy.
    "routes": [
        { "pattern": "www.seonotebook.dev", "custom_domain": true },
        { "pattern": "seonotebook.dev", "custom_domain": true }
    ]
}
