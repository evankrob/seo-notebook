---
import Layout from '../components/Layout.astro';
import AppPreview from '../components/AppPreview.astro';

const repo = 'https://github.com/evankrob/seo-notebook';
const deploy = 'https://deploy.workers.cloudflare.com/?url=' + repo;

const highlights = [
    { tag: 'MCP', value: 'Any agent', note: 'Claude Code, Cursor, Windsurf or anything that speaks MCP' },
    { tag: 'Diffs', value: 'Old → new', note: 'Titles, meta, headings, content, schema, redirects' },
    { tag: 'Google', value: 'GSC + GA4', note: 'Your own Search Console and Analytics data' },
    { tag: 'Open source', value: '100% yours', note: 'MIT, on your Cloudflare account' },
];

const features = [
    { title: 'Agents log by URL', body: 'Give each agent its own token. It sends the page URL, what changed and why; sites and pages are created for you.' },
    { title: 'Every field, before and after', body: 'Old and new values for titles, meta descriptions, H1s, content, schema and redirects, so nothing is a mystery later.' },
    { title: 'Real Search Console and GA4', body: 'A read-only service account pulls 16 months of history, syncs daily, and backfills new pages as agents touch them.' },
    { title: 'Impact you can trust', body: '28-day before and after windows, overlap detection and control groups. It says “inconclusive” until the data says more.' },
    { title: 'A timeline you can read', body: 'An activity calendar, filters by site and tag, search, and change markers right on the chart.' },
    { title: 'Reports for clients', body: 'Share a read-only link to a site’s changes and results for any period, with a CSV export.' },
];

const mcp = 'claude mcp add --transport http seo-notebook \\\n  https://notebook.your-agency.com/mcp \\\n  --header "Authorization: Bearer <token>"';
---
<Layout
    title="SEO Notebook · Track what your AI agents change, and what it did"
    description="An open-source change log your AI agents write to. Every edit, old and new value, and why, lined up against Search Console and GA4. Runs on your Cloudflare account."
>
    <header class="nav wrap">
        <a class="brand" href="/"><span class="logo">N</span>SEO Notebook</a>
        <nav>
            <a href="#features">Features</a>
            <a href="#how">How it works</a>
            <a href={repo}>GitHub</a>
        </nav>
        <a class="btn small" href={deploy}>Deploy</a>
    </header>

    <main>
        <section class="hero wrap">
            <p class="eyebrow">Open source · MCP-native · Runs on your Cloudflare</p>
            <h1>Your agents change your site.<br /><span>See what it did.</span></h1>
            <p class="sub">SEO Notebook records every change your AI agents make, from the page and the old and new values to why they made it, then lines it up with Search Console and GA4 so you can see the impact.</p>
            <div class="ctas">
                <a class="btn" href="#demo">See demo</a>
                <a class="btn secondary" href={repo}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    GitHub
                </a>
                <a class="btn cf" href={deploy}>
                    Deploy to Cloudflare
                </a>
            </div>
        </section>

        <section class="stats wrap" aria-label="Highlights">
            {highlights.map(h => (
                <div class="stat">
                    <span class="tag">{h.tag}</span>
                    <strong>{h.value}</strong>
                    <span>{h.note}</span>
                </div>
            ))}
        </section>

        <section id="demo" class="demo wrap" aria-label="Product preview">
            <AppPreview />
            <p class="caption">Fictional demo data. Every card is a change an agent logged; the amber dot marks it on the chart.</p>
        </section>

        <section id="features" class="features wrap">
            <h2>A change log your agents keep for you</h2>
            <p class="lead">When an agent edits a page, it records what changed and why. You see the before and after in your own data.</p>
            <div class="grid">
                {features.map(f => (
                    <div class="feature">
                        <h3>{f.title}</h3>
                        <p>{f.body}</p>
                    </div>
                ))}
            </div>
        </section>

        <section id="how" class="how wrap">
            <h2>Running in three steps</h2>
            <ol>
                <li>
                    <span class="n">1</span>
                    <h3>Deploy to your Cloudflare</h3>
                    <p>One click creates the Worker, database, storage and queue. Cloudflare Access decides who can open it.</p>
                </li>
                <li>
                    <span class="n">2</span>
                    <h3>Connect your agents</h3>
                    <p>Create a token per agent and add one line to its project rules so it logs every edit.</p>
                    <pre><code>{mcp}</code></pre>
                </li>
                <li>
                    <span class="n">3</span>
                    <h3>Connect Google</h3>
                    <p>Add a service account to Search Console and GA4. History arrives in minutes and syncs daily.</p>
                </li>
            </ol>
        </section>

        <section class="final wrap">
            <h2>Know which changes worked.</h2>
            <div class="ctas">
                <a class="btn cf" href={deploy}>Deploy to Cloudflare</a>
                <a class="btn secondary" href={repo}>View on GitHub</a>
            </div>
        </section>
    </main>

    <footer class="wrap">
        <span><span class="logo small">N</span> SEO Notebook · MIT licensed</span>
        <span>Observations, not attribution.</span>
        <a href={repo}>GitHub</a>
    </footer>
</Layout>

<style>
    .nav { display: flex; align-items: center; gap: 20px; height: 72px; }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; text-decoration: none; letter-spacing: -0.02em; }
    .logo { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--brand); color: #fff; font-family: Georgia, serif; font-size: 19px; }
    .logo.small { display: inline-grid; width: 20px; height: 20px; border-radius: 6px; font-size: 13px; vertical-align: -4px; margin-right: 4px; }
    .nav nav { display: flex; gap: 4px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 4px; box-shadow: var(--shadow); }
    .nav nav a { text-decoration: none; font-size: 14px; color: var(--text-2); padding: 6px 14px; border-radius: 999px; }
    .nav nav a:hover { background: var(--surface-2); color: var(--text); }

    .btn { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 600; font-size: 15px; padding: 12px 22px; border-radius: 999px; background: var(--brand); color: #fff; border: 1px solid var(--brand); transition: transform .15s ease, filter .15s ease; }
    .btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
    .btn.small { padding: 8px 16px; font-size: 14px; }
    .btn.secondary { background: var(--surface); color: var(--text); border-color: var(--border-strong); }
    .btn.cf { background: #f38020; border-color: #f38020; color: #fff; }
    .btn svg { width: 18px; height: 18px; }

    .hero { text-align: center; padding: 72px 20px 36px; }
    .eyebrow { display: inline-block; font-size: 13px; color: var(--brand-ink); background: var(--brand-soft); border-radius: 999px; padding: 6px 14px; margin: 0 0 22px; }
    h1 { font-size: clamp(38px, 6.4vw, 68px); line-height: 1.04; letter-spacing: -0.035em; margin: 0 auto; max-width: 900px; font-weight: 750; }
    h1 span { color: var(--brand-2); }
    .sub { font-size: clamp(17px, 2.1vw, 20px); line-height: 1.55; color: var(--text-2); max-width: 680px; margin: 22px auto 32px; }
    .ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-top: 40px; padding-bottom: 40px; }
    .stat { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 20px 22px; box-shadow: var(--shadow); display: grid; gap: 4px; }
    .stat .tag { justify-self: end; font-size: 11px; font-weight: 600; color: var(--brand-ink); background: var(--brand-soft); border-radius: 999px; padding: 3px 10px; }
    .stat strong { font-size: 30px; letter-spacing: -0.03em; }
    .stat span:last-child { font-size: 13px; color: var(--muted); line-height: 1.45; }

    .demo { padding-top: 24px; padding-bottom: 24px; scroll-margin-top: 24px; }
    .caption { text-align: center; font-size: 13px; color: var(--muted); margin-top: 14px; }

    h2 { font-size: clamp(28px, 3.6vw, 40px); letter-spacing: -0.03em; margin: 0 0 12px; text-align: center; }
    .lead { text-align: center; color: var(--text-2); font-size: 18px; max-width: 620px; margin: 0 auto 36px; line-height: 1.55; }
    .features { padding-top: 88px; padding-bottom: 40px; scroll-margin-top: 24px; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .feature { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow); }
    .feature h3 { margin: 0 0 8px; font-size: 17px; letter-spacing: -0.01em; }
    .feature p { margin: 0; color: var(--text-2); line-height: 1.6; font-size: 15px; }

    .how { padding-top: 72px; padding-bottom: 40px; scroll-margin-top: 24px; }
    .how ol { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .how li { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow); }
    .n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--brand-soft); color: var(--brand-ink); font-weight: 700; margin-bottom: 14px; }
    .how h3 { margin: 0 0 8px; font-size: 17px; }
    .how p { margin: 0; color: var(--text-2); line-height: 1.6; font-size: 15px; }
    pre { margin: 14px 0 0; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 12px; font-size: 12px; line-height: 1.6; white-space: pre; overflow-x: auto; color: var(--text-2); }

    .final { text-align: center; padding-top: 88px; padding-bottom: 88px; }
    .final h2 { margin-bottom: 24px; }

    footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; border-top: 1px solid var(--border); padding-top: 24px; padding-bottom: 40px; font-size: 13px; color: var(--muted); }

    @media (max-width: 900px) {
        .stats { grid-template-columns: repeat(2, 1fr); }
        .grid, .how ol { grid-template-columns: 1fr; }
        .nav nav { display: none; }
        .nav .btn { margin-left: auto; }
    }
    @media (max-width: 480px) {
        .hero { padding-top: 40px; }
        .stats { grid-template-columns: 1fr; }
        .ctas .btn { width: 100%; justify-content: center; }
    }
</style>
