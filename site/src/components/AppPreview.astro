---
// A static rendering of the notebook UI with fictional data. No scripts.
const weeks = 20;
// Deterministic "activity" so every build looks the same.
const cells = Array.from({ length: weeks * 7 }, (_, i) => {
    const n = (i * 37 + 11) % 23;
    return i > 60 && n < 3 ? 1 + (n % 3) : i > 100 && n < 5 ? 1 : 0;
});
const months = ['Jun', 'Jul', 'Aug', 'Sep', 'Oct'];

// Clicks per day for the chart, with a lift after the change marker.
const days = 60;
const values = Array.from({ length: days }, (_, i) => {
    const base = 30 + ((i * 13) % 7) * 2 - (i % 7 === 5 || i % 7 === 6 ? 8 : 0);
    return i >= 32 ? Math.round(base * 1.32) : base;
});
const max = Math.max(...values);
const x = (i: number) => 20 + (i / (days - 1)) * 560;
const y = (v: number) => 150 - (v / max) * 120;
const path = values.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const marker = 30;
---
<div class="frame" role="img" aria-label="SEO Notebook showing a timeline of agent changes, a clicks chart and an impact summary">
    <div class="frame-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url">notebook.your-agency.com</span>
        <span class="host">Cloudflare Workers</span>
    </div>
    <div class="app">
        <aside class="side">
            <div class="brand"><span class="logo">N</span>SEO Notebook</div>
            <div class="totals">
                <div><strong>128</strong><span>Changes</span></div>
                <div><strong>9</strong><span>Sites</span></div>
                <div><strong>4</strong><span>Agents</span></div>
            </div>
            <div class="seg"><span>Trend</span><span class="on">Calendar</span></div>
            <div class="heat">
                <div class="grid">{cells.map(c => <i class={`l${c}`} />)}</div>
                <div class="months">{months.map(m => <span>{m}</span>)}</div>
            </div>
            <div class="nav-title">Sites</div>
            <div class="nav on"><span>cedar.example</span><b>42</b></div>
            <div class="nav"><span>fernhollow.example</span><b>31</b></div>
            <div class="nav"><span>larkspur.example</span><b>18</b></div>
            <div class="nav-title">Tags</div>
            <div class="tags"><span>#titles 24</span><span>#schema 9</span><span>#cro 6</span></div>
        </aside>
        <div class="main">
            <div class="top"><strong>Timeline</strong><span>/ cedar.example</span><em>Search changes, pages, tags…</em></div>
            <div class="panel">
                <div class="panel-head"><strong>Performance</strong><span class="pill">LIVE · GOOGLE</span></div>
                <svg viewBox="0 0 600 170" class="chart" aria-hidden="true">
                    <line x1="20" y1="30" x2="580" y2="30" /><line x1="20" y1="90" x2="580" y2="90" /><line x1="20" y1="150" x2="580" y2="150" />
                    <path d={path} />
                    <circle cx={x(marker)} cy={y(values[marker])} r="6" />
                </svg>
            </div>
            <article class="card">
                <div class="meta"><span class="avatar">CC</span>21m ago · Title &amp; meta<span class="pill">shipped</span></div>
                <h4>Clarified the garden tools title</h4>
                <p>The old title didn’t say what we sell. Lead with the product and the use case.</p>
                <div class="callout">
                    <div class="field">Title</div>
                    <del>Garden Tools | Cedar &amp; Finch</del> → <ins>Durable Garden Tools for Small Yards | Cedar &amp; Finch</ins>
                </div>
                <div class="impact">
                    <div><small>Before · 28d</small><strong>588</strong></div>
                    <div><small>After · 28d</small><strong>792</strong></div>
                    <div class="up"><small>Change</small><strong>+34.7%</strong></div>
                </div>
                <div class="foot">Claude Code · via MCP · cedar.example/garden-tools</div>
            </article>
        </div>
    </div>
</div>

<style>
    .frame { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-lg); overflow: hidden; text-align: left; }
    .frame-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--muted); }
    .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
    .url { margin: 0 auto; background: var(--surface-2); border-radius: 999px; padding: 3px 14px; font-family: ui-monospace, monospace; }
    .host { font-family: ui-monospace, monospace; }
    .app { display: grid; grid-template-columns: 210px minmax(0, 1fr); font-size: 12px; }
    .side { border-right: 1px solid var(--border); padding: 16px 14px; display: grid; gap: 10px; align-content: start; }
    .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; }
    .logo { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; background: var(--brand); color: #fff; font-family: Georgia, serif; }
    .totals { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
    .totals strong { display: block; font-size: 16px; }
    .totals span { color: var(--muted); font-size: 10px; }
    .seg { display: grid; grid-template-columns: 1fr 1fr; background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; padding: 2px; text-align: center; color: var(--muted); font-size: 11px; }
    .seg span { padding: 3px; border-radius: 999px; }
    .seg .on { background: var(--surface); color: var(--brand-ink); font-weight: 600; }
    .heat { background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 8px; }
    .grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); gap: 2px; }
    .grid i { aspect-ratio: 1; border-radius: 2px; background: var(--heat-0); }
    .grid .l1 { background: var(--heat-1); } .grid .l2 { background: var(--heat-2); } .grid .l3 { background: var(--heat-4); }
    .months { display: flex; justify-content: space-between; font-size: 9px; color: var(--muted); margin-top: 5px; }
    .nav-title { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-top: 4px; }
    .nav { display: flex; justify-content: space-between; padding: 5px 8px; border-radius: 8px; color: var(--text-2); }
    .nav.on { background: var(--brand-soft); color: var(--brand-ink); font-weight: 600; }
    .nav b { font-weight: 500; color: var(--muted); }
    .tags { display: flex; flex-wrap: wrap; gap: 4px; }
    .tags span { border: 1px solid var(--border); background: var(--surface-2); border-radius: 999px; padding: 1px 7px; font-size: 10px; color: var(--text-2); }
    .main { padding: 16px 18px 18px; background: var(--bg); display: grid; gap: 12px; align-content: start; }
    .top { display: flex; gap: 6px; align-items: center; font-size: 14px; }
    .top span { color: var(--muted); }
    .top em { margin-left: auto; font-style: normal; font-size: 11px; color: var(--muted); border: 1px solid var(--border); background: var(--surface); border-radius: 999px; padding: 4px 12px; }
    .panel, .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; }
    .panel-head { display: flex; justify-content: space-between; align-items: center; }
    .pill { font-size: 9px; font-weight: 600; letter-spacing: .04em; background: var(--brand-soft); color: var(--brand-ink); border-radius: 999px; padding: 2px 8px; }
    .chart { width: 100%; height: auto; display: block; margin-top: 6px; }
    .chart line { stroke: var(--border); }
    .chart path { fill: none; stroke: var(--brand-2); stroke-width: 2.25; }
    .chart circle { fill: var(--surface); stroke: var(--amber); stroke-width: 2.5; }
    .meta { display: flex; align-items: center; gap: 8px; color: var(--muted); }
    .meta .pill { margin-left: auto; }
    .avatar { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand-ink); font-size: 9px; font-weight: 700; }
    h4 { margin: 8px 0 4px; font-size: 14px; }
    p { margin: 0 0 10px; color: var(--text-2); }
    .callout { border-left: 3px solid var(--brand-2); background: var(--surface-2); border-radius: 0 8px 8px 0; padding: 8px 10px; line-height: 1.5; }
    .field { font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
    del { color: var(--red-ink); }
    ins { color: var(--brand-ink); text-decoration: none; font-weight: 600; }
    .impact { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0; }
    .impact div { background: var(--surface-2); border-radius: 8px; padding: 8px 10px; }
    .impact small { display: block; font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
    .impact strong { font-size: 16px; }
    .impact .up strong { color: var(--brand-2); }
    .foot { border-top: 1px solid var(--border); padding-top: 8px; color: var(--muted); font-size: 11px; }
    @media (max-width: 720px) {
        .app { grid-template-columns: 1fr; }
        .side { display: none; }
        .host { display: none; }
        .top em { display: none; }
    }
</style>
